# ─────────────────────────────────────────────────────────────────────────────
# AI Debate Room — 환경 설정 예제
#
#   cp .env.example .env   후 값을 채우세요.
#   .env 는 .gitignore 에 있습니다. 절대 커밋하지 마세요.
#   키는 서버에서만 읽힙니다. API 응답과 프론트엔드로는 나가지 않습니다.
#
#   fake 모드(`--provider-override fake`)로 돌릴 때는 아래를 하나도 안 채워도
#   됩니다. 실제 모델을 부를 때만 필요합니다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 프로바이더 슬롯 ──────────────────────────────────────────────────────────
# 참가자마다 서로 다른 슬롯을 지정할 수 있습니다. 게이트웨이 한 개를 거치지
# 않고 각 엔드포인트를 직접 호출합니다.
#
#   NAME      config/participants.yaml 의 `provider:` 가 참조하는 이름
#   BASE_URL  OpenAI 호환 루트. **`/v1` 까지** 씁니다 (`/chat/completions` 는 뺌)
#   API_KEY   비워두면 Authorization 헤더를 아예 안 붙입니다
#             (로컬 vLLM/Ollama/LM Studio 처럼 인증 없는 엔드포인트용)
#
# NAME 과 BASE_URL 이 모두 채워진 슬롯만 등록됩니다. 슬롯 번호는 1..9 까지
# 스캔하므로 3개로 부족하면 _4, _5 ... 를 그냥 추가하면 됩니다.

# 슬롯 1 — 키 발급: https://platform.openai.com/api-keys
DEBATE_PROVIDER_1_NAME=openai
DEBATE_PROVIDER_1_BASE_URL=https://api.openai.com/v1
DEBATE_PROVIDER_1_API_KEY=

# 슬롯 2 — 키 발급: https://console.groq.com/keys  (무료 티어, 레이트리밋 빡빡함)
DEBATE_PROVIDER_2_NAME=groq
DEBATE_PROVIDER_2_BASE_URL=https://api.groq.com/openai/v1
DEBATE_PROVIDER_2_API_KEY=

# 슬롯 3 — 키 발급: https://openrouter.ai/keys  (무료 모델은 모델ID가 :free 로 끝남)
DEBATE_PROVIDER_3_NAME=openrouter
DEBATE_PROVIDER_3_BASE_URL=https://openrouter.ai/api/v1
DEBATE_PROVIDER_3_API_KEY=

# 예시 — 인증 없는 로컬 엔드포인트를 쓰려면 이런 식으로 슬롯을 추가:
# DEBATE_PROVIDER_4_NAME=local
# DEBATE_PROVIDER_4_BASE_URL=http://localhost:8000/v1
# DEBATE_PROVIDER_4_API_KEY=

# ── 실행 파라미터 ────────────────────────────────────────────────────────────
DEBATE_MAX_CONCURRENCY=3          # 동시 요청 상한. 무료 프로바이더 때문에 3
DEBATE_REQUEST_TIMEOUT_S=120      # 호출 1건 타임아웃 (관측된 최대 지연 54s 의 2.2배)
DEBATE_RETRY_ATTEMPTS=3           # 재시도 상한. 소진 시 해당 참가자만 dropout

# 참가자 1명이 한 라운드에 쓸 수 있는 총 시간(재시도 포함).
# RETRY_ATTEMPTS × REQUEST_TIMEOUT_S 보다 작게 잡으면 호출이 매달릴 때 재시도가
# 잘립니다. 어긋나면 실행 시 경고가 뜹니다.
DEBATE_ROUND_TIMEOUT_S=400

# 발언 1건의 출력 토큰 상한.
# 한국어는 600자만 해도 600~900 토큰이고, thinking 계열 모델은 사고 토큰까지
# 이 예산에서 씁니다. 빠듯하면 발언이 중간에 끊기고(finish_reason=length)
# 잘린 발언은 Judge 채점을 그대로 오염시킵니다.
DEBATE_MAX_OUTPUT_TOKENS=2048
DEBATE_PRICING_PATH=config/pricing.yaml
DEBATE_DB_PATH=data/debates.db    # 슬라이스 3부터 사용

# 한국어 토큰 추정 계수. 슬라이스 3에서 estimate vs actual 로 보정합니다.
# 기록되는 실사용량은 항상 API 응답값이라 이 값과 무관합니다.
DEBATE_KO_TOKENS_PER_CHAR=1.0
